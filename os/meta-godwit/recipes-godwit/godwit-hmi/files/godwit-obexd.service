[Unit]
Description=Bluetooth phonebook access for the Godwit HMI
# obexd normally runs in a user's login session; the HMI has none, so run it
# on the system bus as the HMI's user. Not needed to show the HMI, so it is
# ordered after Bluetooth and never on the boot path.
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=dbus
BusName=org.bluez.obex
User=godwit
Group=godwit
# The HMI reads the downloaded phonebooks from here
Environment=XDG_CACHE_HOME=/var/cache/godwit
CacheDirectory=godwit
ExecStart=/usr/libexec/bluetooth/obexd --nodetach --system-bus
Restart=on-failure

[Install]
WantedBy=multi-user.target
