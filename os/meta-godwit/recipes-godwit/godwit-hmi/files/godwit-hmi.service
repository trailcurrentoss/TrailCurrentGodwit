[Unit]
Description=Godwit head unit HMI
# Started as early as the display allows. Nothing slow (network, Bluetooth,
# audio, routing) may be ordered before this unit.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service systemd-tmpfiles-setup.service
Wants=systemd-udevd.service
Conflicts=shutdown.target
Before=shutdown.target
# Never give up: if the display is late, a crash loop must not end in a
# failed unit and a blank screen until someone logs in
StartLimitIntervalSec=0

[Service]
Type=simple
User=godwit
Group=godwit
Environment=LANG=C.UTF-8
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_EGLFS_KMS_ATOMIC=1
# Drive standard 1080p60 (CEA, 148.5 MHz) rather than the EDID's preferred
# mode. Until the HDMI bridge has read the screen, it hands the SoC a stand-in
# EDID whose only modes are reduced-blanking 1080p, which the screen's scaler
# rejects with "No Signal"; eglfs keeps the mode it chose at start.
Environment=QT_QPA_EGLFS_KMS_CONFIG=/etc/godwit/kms.json
Environment=XDG_RUNTIME_DIR=/run/godwit
RuntimeDirectory=godwit
RuntimeDirectoryMode=0700
# Kept when the HMI restarts, so the safety notice accepted this boot is not
# asked again after a crash; /run is cleared at power off
RuntimeDirectoryPreserve=yes
# The user has no home; give Mesa somewhere to keep its shader cache so
# later boots skip compiling shaders
Environment=XDG_CACHE_HOME=/var/cache/godwit
CacheDirectory=godwit
# The display driver probes asynchronously, and simpledrm's boot framebuffer
# node appears long before it, so wait for a connected connector rather than
# for any /dev/dri node (up to 15 s; a few seconds is normal)
ExecStartPre=/bin/sh -c 'for i in $(seq 150); do grep -qx connected /sys/class/drm/card*-*/status 2>/dev/null && exit 0; sleep 0.1; done; exit 1'
ExecStart=/usr/bin/godwit-hmi
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
