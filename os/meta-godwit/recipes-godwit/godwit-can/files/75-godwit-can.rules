# A physical CAN interface has appeared (its driver can load late, for one on
# SPI): apply the CAN settings to it, and publish which port it is on
ACTION=="add", SUBSYSTEM=="net", ATTR{type}=="280", DEVPATH!="/devices/virtual/*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="godwit-can.service"
# One has gone: publish that its port is not found. Its attributes are gone
# too, so it is matched by name.
ACTION=="remove", SUBSYSTEM=="net", KERNEL=="can*", DEVPATH!="/devices/virtual/*", RUN+="/bin/systemctl --no-block start godwit-can.service"
