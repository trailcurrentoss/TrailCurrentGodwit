# Raspberry Pi Compute Module 5 on a base board with an M.2 NVMe slot.
# Read by scripts/setup.sh --board rpi-cm5.
BOARD_NAME="Raspberry Pi CM5"
# AGL's own Pi 5 machine (meta-raspberrypi), which includes the CM5 device trees
MACHINE=raspberrypi5
# This board's layer, linked into the AGL checkout
BSP_LAYER=meta-rpi-cm5
# AGL features when none are given on the command line. cm5-nvme boots from
# NVMe; cm5-godwit adds the godwit feature and the Pi's changes to it.
FEATURES="agl-demo agl-devel cm5-nvme cm5-godwit"
