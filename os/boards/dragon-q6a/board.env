# Radxa Dragon Q6A (Qualcomm QCS6490). Read by scripts/setup.sh --board dragon-q6a.
BOARD_NAME="Radxa Dragon Q6A"
# Yocto machine, from meta-dragon-q6a/conf/machine
MACHINE=dragon-q6a
# This board's layer, linked into the AGL checkout
BSP_LAYER=meta-dragon-q6a
# AGL features when none are given on the command line
FEATURES="agl-demo agl-devel godwit"
