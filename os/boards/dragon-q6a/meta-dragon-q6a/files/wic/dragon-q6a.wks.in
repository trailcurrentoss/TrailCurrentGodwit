# short-description: UEFI disk image for the Radxa Dragon Q6A
# long-description: GPT image with an ESP holding systemd-boot, the kernel and
# the board DTB, followed by an ext4 root. Write it to a microSD card, USB
# drive, NVMe or eMMC; the board firmware boots any of them. On first boot
# godwit-preinit adds the data and content partitions after these. The partition
# IDs are fixed so that a new build's boot and root still match the table of a
# drive updated in place.

part /boot --source bootimg_efi --sourceparams="loader=systemd-boot,dtb=qcs6490-radxa-dragon-q6a.dtb" --label boot --part-type C12A7328-F81F-11D2-BA4B-00A0C93EC93B --active --align 1024 --size 128M --use-uuid --uuid 5F2A6C1E-8B3D-4E7A-9C41-2D6F0A7B3E11 --part-name boot

part / --source rootfs --fstype=ext4 --label root --align 1024 --use-uuid --uuid A3C94E27-6D18-4F0B-8A52-7E1D9C3F6B20 --part-name root

# usb_storage.quirks: Samsung T7 SSDs (04e8:4001) stall under UAS on this
# board's USB 3 port and the reset takes the whole USB bus with it, touch and
# encoders included. Plain usb-storage works.
bootloader --ptable gpt --timeout=0 --append="quiet ro init=/usr/sbin/godwit-preinit console=ttyMSM0,115200 console=tty0 rootwait rootfstype=ext4 clk_ignore_unused pd_ignore_unused usb_storage.quirks=04e8:4001:u"
