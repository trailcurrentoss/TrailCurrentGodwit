# Raspberry Pi 5 booting from NVMe, with a Waveshare 10.1-DSI-TOUCH-B panel
# mounted in landscape. Read by scripts/setup.sh --board rpi5-dsi.
BOARD_NAME="Raspberry Pi 5 with Waveshare 10.1\" DSI panel"
# Same Yocto machine as the CM5, so the build directory needs its own name
MACHINE=raspberrypi5
BUILD_NAME=rpi5-dsi
# This board's layer, linked into the AGL checkout
BSP_LAYER=meta-rpi5-dsi
# cm5-nvme and cm5-godwit come from boards/rpi-cm5: the Pi 5 has the same
# chip and boots NVMe the same way. rpi5-dsi adds the panel, rpi-can-fd-hat
# the Waveshare 2-CH CAN FD HAT.
FEATURES="agl-demo agl-devel cm5-nvme cm5-godwit rpi5-dsi rpi-can-fd-hat"
