# Copy to scripts/dev.env (gitignored) and fill in, or let scripts/setup.sh
# prompt for these on first run. Every setting is optional, and they apply to
# every board.

# An existing AGL checkout on the same branch (the folder holding .repo); its
# .repo is copied so the layers are not cloned again.
AGL_REPO_SEED=

# Shared BitBake downloads and shared-state cache. Every board's build
# directory uses the same two folders, so sources are fetched once and the
# host tools are built once.
AGL_DL_DIR=
AGL_SSTATE_DIR=

# Another build's sstate-cache, read but never written.
AGL_SSTATE_MIRROR=
