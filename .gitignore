# AGL source checkout (fetched by os/scripts/setup.sh with repo)
/os/agl/
/os/tools/
/os/setup.log
/os/build-*.log

# Yocto build output, in case a build directory or cache lands outside agl/
/os/build*/
sstate-cache/
downloads/
tmp/
*.wic
*.wic.zst
*.wic.bmap

# Desktop builds of the HMI
/build/

# ESP-IDF builds of the dial firmware (sdkconfig is generated from
# sdkconfig.defaults and must never be edited or committed)
/dial-*/build/
/dial-*/sdkconfig
/dial-*/sdkconfig.old
/dial-*/dependencies.lock
/dial-*/managed_components/

# Staged images, Firehose loader and edl-ng for EDL flashing
/os/flash/

# FreeCAD backups
*.FCBak

# AI agent configuration (local only — never commit)
.claude
.claude/
.claude.md
CLAUDE.md
CLAUDE.MD
.cursorrules
.cursor/
.github/copilot*
.aider*
.continue/
.codeium/
.tabnine*
.sourcery.yaml
