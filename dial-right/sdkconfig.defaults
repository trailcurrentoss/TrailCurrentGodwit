# Godwit dial, right side, on the Elecrow CrowPanel 1.28". Read after
# ../dial-common/sdkconfig.defaults (everything every dial shares) and
# ../dial-common/boards/crowpanel-1.28/sdkconfig.defaults (the board).
#
# NEVER edit `sdkconfig` directly. After changing this file:
#
#     rm sdkconfig && idf.py build

CONFIG_GODWIT_DIAL_SIDE_RIGHT=y
